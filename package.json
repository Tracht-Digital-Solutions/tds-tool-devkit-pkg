{
  "name": "@tracht-digital-solutions/tds-tool-devkit",
  "version": "0.2.6",
  "description": "JSON & design utilities for the TDS tools platform: JSON formatter/validator, WCAG contrast checker and the Designsystem-Studio (visual CSS & design-system generator). Fully client-side except the studio's export/analysis endpoints.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "tools",
    "islands",
    "src/studio",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tools/*": "./tools/*",
    "./islands/*": "./islands/*",
    "./studio/*": "./src/studio/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit && tsc -p tsconfig.islands.json",
    "lint:primitives": "tds-lint-primitives",
    "clean": "rimraf dist",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "@tracht-digital-solutions/tds-shared": ">=0.59.1 <1",
    "@tracht-digital-solutions/tds-tools-contract": "^1.2.0",
    "astro": ">=6",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@tracht-digital-solutions/tds-shared": "^0.59.3",
    "@tracht-digital-solutions/tds-tools-contract": "^1.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tracht-Digital-Solutions/tds-tool-devkit-pkg.git"
  }
}
